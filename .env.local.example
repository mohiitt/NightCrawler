# NIGHTCRAWLER - copy to .env.local and fill in. Never commit .env.local.
# Grouped by owner so each teammate knows exactly what they must acquire.

# ============================================================
# SHARED
# ============================================================
# Selects DB backend for @nightcrawler/db: "clickhouse" | "sqlite"
DB_DRIVER=sqlite
# Base URL of the agent run/stream service consumed by the web UI.
AGENT_SERVICE_URL=http://localhost:8787

# ============================================================
# TEAMMATE A - Data & Analytics (packages/db, apps/ingest)
# ============================================================
CLICKHOUSE_URL=https://your-instance.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# Local fallback path when DB_DRIVER=sqlite
SQLITE_PATH=nightcrawler.sqlite
# Optional Airbyte demo sync
AIRBYTE_API_KEY=

# ============================================================
# TEAMMATE B - Agent & Governance (apps/agent)
# ============================================================
GUILD_API_KEY=
GUILD_ORG_ID=
# LLM (pick one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Composio publish to cited.md (filesystem fallback needs no key)
COMPOSIO_API_KEY=

# ============================================================
# TEAMMATE C - Visualization & Economy (apps/web, apps/buyer)
# ============================================================
THESYS_C1_API_KEY=
# x402 / CDP on Base Sepolia
SELLER_ADDRESS=0xYourReceivingWalletAddress
BUYER_PRIVATE_KEY=0xYourBaseSepoliaTestnetPrivateKey
# Testnet facilitator needs no signup; CDP facilitator needs the keys below.
X402_FACILITATOR_URL=https://x402.org/facilitator
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
