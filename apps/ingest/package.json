{
  "name": "@nightcrawler/ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Teammate A - DB schema bootstrap, seed_db (Golden Path), optional Airbyte sync.",
  "scripts": {
    "ping": "node --env-file=../../.env --import tsx/esm src/ping_db.ts",
    "seed": "node --env-file=../../.env --import tsx/esm src/seed_db.ts",
    "seed:reset": "RESET=true node --env-file=../../.env --import tsx/esm src/seed_db.ts",
    "verify": "node --env-file=../../.env --import tsx/esm src/verify_db.ts",
    "airbyte": "node --env-file=../../.env --import tsx/esm src/airbyte_demo.ts",
    "airbyte:demo": "node --env-file=../../.env --import tsx/esm src/airbyte_demo.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nightcrawler/contracts": "workspace:*",
    "@nightcrawler/db": "workspace:*",
    "@faker-js/faker": "^9.3.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
